,0.075,[[4,5]],[["",42,-39,0]],0,109],[7105803,20392,8,0.437,0.306,[[0,91]],[],0,110],[7106842,20395,148,4.026,3.231,[[0,92]],[["",41,-3,1],["",41,-3,1],["",43,-3,1],["",43,-3,0]],0,111],[7107590,20395,11,0.437,0.306,[[0,93]],[],0,112],[7114520,20396,42,1.112,0.852,[[0,94]],[],0,113],[7113604,20396,16,0.622,0.461,[[0,95]],[],0,114],[7122672,20397,3,0.142,0.092,[[0,96]],[["e04902b6_2f6ee1a3",44,0,0,"Can this be in the `else`?"]],0,115],[7122260,20402,43,1.112,0.852,[[0,97]],[["0ac9927e_babbea34",44,-3,0,"Can we just do ``` if(incognito) { self.locationBarSteadyView.isIncognito = YES; } ``` Along with the other changes proposed?"],["5e144051_65621180",41,-3,0,"If we do an early check before setting incognito, we can just do the else statement. I.e. if we don't fall into the else statement, we shouldn't even be setting incognito (since the default is false,…"],["01ee8a82_558c7abf",40,0,1,"Please name the property as incognito and set the getter as isIncognito follow the style guide, if not this makes it look as it's just a readonly property, which is not.…"]],0,116],[7156001,20406,6,0.28,0.2,[[0,98]],[],0,117],[7155844,20409,2,0.142,0.092,[[0,99]],[],0,118],[7156183,20411,5,0.28,0.2,[[0,100]],[["adf61358_def74f8a",27,-2,0,"Does this work for you locally? I would expect the mediator to stop existing when the page action menu is dismissed. Maybe we should use a direct reference to the contextualSheetHandler instead?"]],0,119],[7156019,20411,1,0.142,0.092,[[0,101]],[],0,120],[7169439,20411,2,0.142,0.092,[[0,102]],[["8091ca29_16c02b60",11,0,1,"How is this related to this animation bug?"]],0,121],[7129978,20411,346,6.361,5.1,[[0,103]],[["2c0e23bf_35fbdcaf",45,-7,1,"This code is triggered multiple times when `updateBadgesShownForWebState` is called. Did you encounter any issues where we were adding more than one camera badge or more than one microphone badge at…"],["3914d9d5_b8d1c30d",45,-7,1,"Can we have a TODO over this to migrate to LocationBarBadge? Maybe under this bug: b/458307626"],["5ef3003f_bd1be346",45,-7,1,"remove newline?"],["65b6a8cf_3fa70e44",46,-7,1,"Change to `[self addBadgeToStackView:badgeButton];` so that the view animates in just like the first displayed badge (unless you don't want this behavior)"],["e00cedc2_77bf7b6f",45,-7,1,"Don't we need this?"],["ee450748_b1810ed6",41,-7,0,"Why do we do this?"],["4398ca21_463f7a99",46,-6,1,"I'm not sure I see the need for 2 separate functions for `updateFirstBadge` and `updateSecondBadge`. I would think that calling `updateDisplayedBadges` could just iterate through the collection and…"],["4a4e2c6c_38b6f99f",46,-6,1,"Since we have `currentlyDisplayedBadges`, can we remove `displayedBadge` and `secondDisplayedBadge`?"],["5de072ea_4dfb2858",47,-6,1,"UI consts should go in the VC's namespace. This file is reserved for constants that go beyond UI/sizing"],["7193512c_93c1cedb",46,-6,1,"In what scenario would we be handling a `displayedBadgeItem` while `badgeCount` is < 1?"],["97373755_fe042459",41,-6,1,"What does this do?"],["9863b406_b1f7910c",46,-6,1,"Do we need to track badgeCount? Can we just check if a `secondDisplayedBadge` and/or `displayedBadge` exists? I think there should only ever be 0-2 Alternatively, we can store an array of badges as a…"],["9af3c224_8df50d24",45,-6,1,"The intended behaviour for 3+ chips is to show a single active badge (any would be fine) + an ellipsis badge. We shouldn't just be showing a single ellipsis badge. Example:…"],["a83535e3_0489c88d",45,-6,1,"What does `onBadgeItemRead` do? I would think we could just do `[badgesToDisplay addObjectsFromArray:badges];` for count 1 and 2"],["ad88c7db_fa5804cd",45,-6,1,"I think this interaction would be cleaner if the mediator could create a list of badges that need to be shown, and the consumer just takes in that list. Then, `count == 1` and `count == 2` could be…"],["ead650c0_d2779739",46,-6,1,"nit: These should be ivars"],["25469f90_b7a6be77",46,-5,1,"When should this be used vs `setupWithDisplayedBadge`?"],["89225126_db90b579",48,-5,1,"Is `infoBar` still needed here? I don't think it makes sense with a list of badges, since IIUC it was to indicate whether a single badge involed an infobar Maybe the `BadgeItem` could contain the…"],["8b6fc829_ed78313e",46,-5,0,"Can we just use `_currentlyDisplayedBadges` to get the badges at any index?"],["99f64bbc_7b03fe42",46,-5,1,"drive-by nit, can we remove this? Looks like an empty protocol"],["9da86061_f77fdc97",46,-5,1,"Shouldn't we hide the entire badge VC in fullscreen? This looks like it will only hide the first"],["b86639fe_b011be41",46,-5,1,"nit: Please start with the positive condition in an if/else (`if (IsProactiveSuggestionsFrameworkEnabled())`)"],["c1fb7e38_4d7c8280",46,-5,1,"This sets the ivar, so it will only work for a single separator. See my other comment below, it might address this too"],["c8375c37_7c48c628",46,-5,1,"Should we return early here, or `CHECK`, if PSF is enabled? Since we don't support unread badges"],["d1498414_4acbce4d",45,-5,1,"nit: Just `else` should achieve the same thing, since count 0 just won't add any badges"],["ea98b435_bb198bef",46,-5,1,"Can we add the separator to the stack view as well? If so, we'll be able to remove the ivar for it, and should have more flexibility to add multiple separators if ever we wanted 3+ badges to show…"],["11b62ad1_48ab2720",45,-2,1,"Any reason you removed all these comments?"],["6d110b53_d5b53597",46,-2,1,"nit: Just return early if `IsProactiveSuggestionsFrameworkEnabled` is enabled instead of wrapping the entire function in an if-statement"],["8836e4ba_85f2c7c0",45,-2,1,"nit: Use `[badges count]` inline instead of a var since it's only referenced once"],["96e86d47_f7cde5b8",46,-2,1,"We should consider separating the animation from this function. If multiple badges are added at once, this animation will execute multiple times in a row, flickering from 0->1 alpha"]],0,122],[7169029,20416,7,0.28,0.2,[[0,104]],[["a22f9bcf_060ed44f",45,-4,0,"Why does this badge 