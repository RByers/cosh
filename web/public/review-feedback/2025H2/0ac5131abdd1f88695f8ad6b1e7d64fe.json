48",130,-1,1,"Can this be at the end, near line 169, instead of being at the beginning?"],["e1d7105b_f43b5ac9",126,-1,1,"If it doesn't matter, just sort by the key?"],["fbb4ec18_e121f505",127,-1,1,"It may be better if there was a separate method that handled this case and then called _install() with the updated destination. Then it is clearer from looking at the calls to see what will happen."]],0,2264],[7204746,20418,18,0.939,0.709,[[56,0.727,35,13],[71,0.273,6,5]],[["daeabc2b_99967998",131,-1,0,"Would it make sense to do this at line 291 and not depend on any particular test expectation config?"]],0,2265],[7204763,20418,10,0.447,0.277,[[54,21]],[["c9deaf06_e2636ab1",50,-1,0,"BTW, I think this can be simplified given line 135."]],0,2266],[7204285,20418,7,0.354,0.253,[[55,27]],[],0,2267],[7204965,20418,62,1.64,1.27,[[53,16]],[["8af58303_cd5ec555",132,-1,1,"Simplify to `using SetSystemdScopeUnitNameForXdgPortalTest = ::testing::Test;`"],["8fcb0103_855d61ee",133,-1,1,"WDYT about moving to namespace dbus_xdg::internal?"],["ab423c24_237e3acb",83,-1,1,"No longer used."],["cfefe459_fd415a46",83,-1,1,"Does it still make sense to have this boolean, if the class can also check if `callbacK_` is null or not?"],["54d91f50_a301f7e8",133,0,1,"No longer used."],["6eec0e51_fd1b1231",83,0,1,"No longer used."]],0,2268],[7214586,20430,195,5.298,4.261,[[53,0.533,17,109],[55,0.382,28,76],[12,0.024,389,3],[56,0.024,36,3],[54,0.024,22,3],[8,0.009,43,1],[11,0.005,146,0]],[["04dd17ed_e8b21f47",1,-5,1,"Wrap at 72 columns."],["4b7fb4b1_6f3f3118",1,-5,1,"\"In SelectFileDialogLinuxPortal, owning_window ...\" for context."],["c8780165_4f498395",134,-5,1,"No longer needed."]],0,2269],[7237910,20431,92,2.946,2.333,[[11,0.716,147,67],[117,0.193,10,19],[106,0.055,50,4],[25,0.037,19,2]],[["30f6464c_65fd5289",135,0,1,"Mark pointer as const."],["c75227ae_aea5b7d0",136,0,1,"No need to initialize here. Mark as const pointer instead."],["d6e8aa2c_b7805dd6",135,0,1,"nit: move above line 23 to sort namespa