1.866,[[0,86]],[["f48beebb_abb64930",1,0,0,"This makes me wonder if we should change pinned tabs entries to be stored as a map keyed on `TabHandle`."]],0,122],[7189559,20414,44,1.341,1.058,[[0,87]],[],0,123],[7199187,20416,10,0.421,0.3,[[0,88]],[],0,124],[7201151,20426,64,2.361,1.866,[[0,89]],[["519874af_3d2e6a3e",14,-2,1,"nit: It's already pinned, so I guess the pin trigger here doesn't matter, but it does feel a little weird to pass unknown. I wonder if there's another option that would be easier to read."],["371f2a49_ac43a5da",27,0,1,"I think we probably need a special enum entry for new tab daisy chaining. It's kind of different from the other daisy chaining."],["6169495b_43a97c0d",27,0,1,"Add a comment explaining this. If the tab is already bound, then it already has a pin source and this pin source will do nothing. If it's not already bound, then this code path will ensure that it's…"],["cc376edc_6e956316",14,0,1,"Can't we use -> here?"]],0,125],[7226419,20427,111,2.361,1.866,[[5,0.61,2,67],[0,0.39,90,44]],[["33841df0_8b718722",29,-1,1,"this name is weird to me, maybe just kUnknown?"],["42502cb5_31bb5cd1",30,-1,1,"since we're mechanically copying the enum, I think we should assume the values match and just do { return trigger as PinTriggerMojo; }"],["6368b09b_5eb738ea",29,-1,1,"brief description of each would be nice, as it ends up in the public api"],["3bae7fec_26567cbf",31,0,0,"up to you but you could use the mojom enum directly in C++"]],0,126],[7249199,20433,134,4.21,3.407,[[5,0.596,3,79],[0,0.404,91,55]],[["a9c5210b_d651dcd2",29,0,0,"nit: i'd make this non-optional, same below. Otherwise there's two ways to sending the same information."]],0,127]]}