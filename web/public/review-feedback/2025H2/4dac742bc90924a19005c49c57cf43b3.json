.205,[[5,18]],[["07378b30_e15ba9e2",22,-1,1,"Isn't this the same as `= default;`?"]],0,234],[7209337,20420,13,0.444,0.311,[[5,19]],[],0,235],[7207401,20420,94,2.906,2.332,[[5,20]],[["6b3b595e_cb5ac942",12,0,0,"nit: `AddCaptureOnUIThrea`d or `AddCaptureOnUI`. ditto for RemoveCaptureUI."]],0,236],[7185664,20426,166,4.504,3.624,[[18,29]],[],0,237],[7228547,20430,182,4.504,3.624,[[5,21]],[["1cd5a0f8_fdf7397b",23,0,1,"Extract this into a helper function `NotifyStateChanged()` or similar that notifies the observers."]],0,238],[7229327,20430,241,4.504,3.624,[[5,22]],[["76d611f4_b1f012bf",23,0,1,"I think it makes sense to use a helper function here as well."]],0,239],[7232233,20430,120,2.906,2.332,[[5,0.952,23,115],[9,0.048,2,5]],[["d0db47fb_b596d576",6,0,1,"nit: format the commit message."],["d3829ace_d7e6e9c8",19,0,1,"Although the logic is simple, I think that it's worth explaining what it means in practice. Something similar to the commit message."]],0,240],[7232079,20431,42,1.384,1.054,[[5,24]],[],0,241],[7253369,20438,196,4.504,3.624,[[5,0.682,25,131],[15,0.318,1,61]],[["183a73ac_1d04f379",6,-1,1,"nit: do"],["96366165_d1ef4b42",12,-1,1,"nit: Is there a specific reason the parameter order was swapped here? The internal overload places the GlobalRenderFrameHostId second. It might be cleaner to keep the ID as the second parameter in…"],["b301edf5_58b35aca",24,0,1,"We may want to move the coordinator stuff to be above this, since IIUC we'd still want to inform the coordinator even if the opener webcontents is being destroyed"]],0,242],[7269313,20440,141,4.504,3.624,[[5,0.987,26,140],[8,0.013,7,1]],[["945979b0_46fc9672",25,0,1,"spelling mistake: prorperty should be property."]],0,243],[7274596,20440,91,2.906,2.332,[[5,27]],[["e582c662_8f6d234d",21,0,1,"This can now be changed to: ``` return @[window_to_check]; ``` and `return @[]` for the early exits."]],0,244],[7274520,20441,2,0.088,0.061,[[7,16]],[],0,245]]}