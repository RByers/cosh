2,0.852,[[0,1472]],[],0,1807],[7036571,20376,2,0.142,0.092,[[0,1473]],[],0,1808],[7055942,20386,102,2.078,1.66,[[0,1474]],[],0,1809],[7079819,20388,6,0.297,0.23,[[12,4]],[["",4,0,0]],0,1810],[7095398,20392,32,1.112,0.852,[[0,1475]],[],0,1811],[7123828,20398,334,6.361,5.1,[[0,1476]],[["2d5f4ef2_0a4259ec",27,0,1,"The current code makes it unclear that the value is not necessarily populated even if there is a current default. So I’d do ``` // Set if we must highlight a search engine. If the value is not nil,…"],["3b8c183c_88ee19a4",4,0,1,"I’d really appreciate if you could clarify the difference between the the case where there is a default selection (but not the current button) and the case where there is no default selection. As far…"],["634c204a_76692ed3",28,0,1,"This comment seems to imply you have the current default in this property. I’d go with // See `CurrentDefaultState`. I really don’t think anything more relevant can be added."],["6ecbba88_db52695a",28,0,1,"This comment is not very clear to me. My first hypothesis is that you’d have a default appearing in the list. That is, let’s say the default is a search engine not available in Japan. In this case,…"],["750b9ff1_77df3381",29,0,1,"As a matter of principle, I guess it should has a documentation. Even if it’s quite clear this way in practice."],["7bd49854_8ac1362a",27,0,1,"I’d add a comment ``` << \"The current default search engine $name was not found in the list of engine.\" ``` This would make it clear what the error is, and what was the expectation."],["9c810474_5ac369d1",27,0,0,"According to Nicolas in https://chromium-review.googlesource.com/c/chromium/src/+/7124726?tab=comments it’s currently true but not necessarily. So I think that instead of what you’re doing today,…"],["a52b9a1b_6f5cbf84",27,0,1,"I don’t understand this line. How do you know there is a current default? For all we know, the current default could be a search engine that is not listed here. Either you should check whether the…"],["c832887d_e30258c7",29,0,1,"I’ve looked at other struct, and it seems like it does not start with `k`. I think you should remove it, as it’s not exactly a constant anymore."],["db8e36d1_3da3c96f",28,0,1,"This is wrong. You’ll get it too if there is a current default but it is either not in the list or should not be shown. I tried to clarify here…"],["fa4f5507_8d48db34",29,0,0,"This needs a comment. Given the length of the file, I think putting it in its own file would simplify slightly the code."],["fa76b2e5_fc50aca0",29,0,0,"if there ??? There misses something here"]],0,1812],[7157203,20409,8,0.437,0.306,[[6,97]],[],0,1813],[7157199,20410,5,0.28,0.2,[[0,1477]],[],0,1814],[7157347,20410,1,0.142,0.092,[[0,1478]],[],0,1815],[7156571,20410,4,0.28,0.2,[[0,1479]],[],0,1816],[7156425,20410,90,2.078,1.66,[[0,0.957,1480,87],[4,0.043,153,3]],[],0,1817],[7166329,20410,173,4.026,3.231,[[0,1481]],[],0,1818],[7167864,20410,2,0.088,0.061,[[1,99]],[],0,1819],[7171200,20412,24,0.622,0.461,[[0,0.778,1482,20],[12,0.148,5,3],[13,0.074,2,1]],[["494a327f_c7c35b2b",30,-1,0,"optional nit: add a big red rectangle around the \"current default\" badge to make it obvious? I use Snipit to do this usually. If it's too much hassle or since this is already uploaded anyway, feel…"],["ac488657_ea8a8303",4,-1,0,"nit: when is later? After M144 branch?"]],0,1820],[7172453,20412,30,0.622,0.461,[[0,0.676,1483,22],[12,0.206,6,6],[13,0.118,3,2]],[["66cc5035_bc9db7b0",20,-1,1,"there is no \"current default\" here :/"]],0,1821],[7197999,20416,3,0.062,0,[[12,7]],[],0,1822],[7198524,20417,10,0.437,0.306,[[0,1484]],[],0,1823],[7203147,20417,35,1.112,0.852,[[0,1485]],[],0,1824],[7201767,20417,7,0.28,0.2,[[0,1486]],[],0,1825],[7203166,20418,2,0.088,0.061,[[1,100]],[],0,1826],[7204255,20418,19,0.662,0.495,[[5,4]],[],0,1827],[7210451,20423,121,2.078,1.66,[[0,0.613,1487,75],[1,0.387,101,46]],[["49f4d918_68f264b0",5,-3,1,"Unclear to me what the difference between kStaticDoodle and kCTADoodle is."],["87b76779_aa219166",