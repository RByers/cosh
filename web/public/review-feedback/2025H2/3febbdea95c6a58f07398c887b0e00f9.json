128679,20398,35,0.025,0.014,[[19,0.889,4,35],[9,0.089,18,0],[8,0.022,15,0]],[],0,1011],[7127645,20398,30,0.032,0.017,[[20,0.788,0,25],[21,0.212,0,5]],[],0,1011],[7129118,20398,67,0.042,0.023,[[22,0.675,2,48],[23,0.325,0,19]],[],0,1011],[7132205,20400,82,3.042,2.433,[[0,0.828,72,69],[15,0.172,9,13]],[["2c8a7203_5ad4a78f",29,0,0,"this means that google.com is false without a command line flag, even if kGlicShareImage is true. Actor is using a call to check for likely dogfood configs, is that something that's desired here?"]],0,1011],[7132071,20401,47,1.77,1.388,[[0,73]],[],0,1012],[7152218,20405,12,0.597,0.431,[[0,74]],[],0,1013],[7156993,20409,203,5.576,4.507,[[0,0.824,75,173],[1,0.074,13,12],[2,0.056,14,10],[15,0.023,10,4],[4,0.023,35,4]],[["15457153_9fa9d60b",12,0,1,"i think we should do something to ensure that the tab wasn't navigated in between capturing image and the rest of the context."],["3933991e_61d6e076",12,0,1,"I'm surprised we need span constructor here. What error do we get when we pass the vector directly?"],["4973cfa3_1c1bcaa1",12,0,1,"where does this come from?"],["518834d7_704b8f57",12,0,1,"Same here, we're resetting the timer, so we shouldn't need this."],["966236ec_6575e1c6",12,0,1,"reset weak ptr factory"],["9beab4c0_71398dd9",12,0,1,"We're resetting the remote so we shouldn't need this."],["a43e902b_f04a6a00",12,0,1,"suggest bundling this in a struct"],["b27f13d8_44faffa5",12,0,1,"I think you also need to start tracking tab destruction, easiest via RegisterWillDetach() (IMO we don't need to handle the tab move window case), otherwise your subscription will outlive the thing…"]],0,1014],[7169844,20412,1,0.169,0.112,[[7,61]],[],0,1015],[7187361,20417,123,3.042,2.433,[[15,0.74,11,93],[0,0.26,76,30]],[["bdaff533_f5a433a8",12,-4,1,"It might help readability here to move this into an else/if on the multi-instance feature check. And both branches could call ToggleUI directly instead of trying to re-use it. Something like this ```…"],["ce645e4e_a9ac5e02",12,-4,1,"You can skip the showing check. If it's detached, it's showing."],["bd26d384_26bd9d4f",12,-3,0,"kind of weird that we're not calling \"close\" but all the \"close*\" methods are deprecated or for testing only."],["d05ddf7a_de96ac50",30,-3,0,"this makes me concerned about losing instances, or state getting out of sync, e.g. with the glictabhelper instance binding, but I didn't spot any immediate issues in my short walkthrough of the code."]],0,1016],[7157622,20425,643,15.464,12.617,[[15,0.52,12,339],[0,0.42,77,270],[2,0.032,15,19],[24,0.014,8,8],[4,0.008,36,4],[25,0.006,0,3]],[["16965e90_6ef6d5ae",14,-16,1,"nit: the value should be \"google\",\"local_system_agent\" is a different feature."],["6be1073d_a373a34e",14,-16,1,"This part of set-up is a bit surprising, I thought BlueBanana only interacts with clipbboard policy?"],["553d239a_9a17abd7",14,-15,1,"This part and the FilesRequestHandler between line 1357 - line 1362 should be removed too. The code is for testing file upload."],["1beca3ff_3d314e3f",12,-1,1,"technically the instance could have been destroyed at this point?"],["9d470dc3_2f4469de",31,-1,0,"kerenzhu: did we ever write up/implement a better way to do this?"],["e6ecade8_9230bbd4",31,-1,1,"will this logic ever pick the wrong web-contents? Are we sure that all indirections are static?"]],0,1017],[7228746,20427,73,3.042,2.433,[[15,0.88,13,65],[0,0.12,78,8]],[],0,1018],[7224251,20431,123,3.042,2.433,[[0,0.961,79,120],[3,0.039,20,3]],[["c179fbb2_684c23a5",32,-5,1,"Parameterizing the entire test suite seems like massive overkill here. Surely we can just add a single test case (or a few) for the particular behavior that changes in this CL?"],["f65293a5_c87db3a8",11,-5,0,"Could GlicShareImageEnterprise being a param of GlicShareImage then (`enable-for-enterprise`, for example). Just curious."]],0,1019],[7243261,20433,11,0.597,0.431,[[0,80]],[["b2620d50_eaf29c27",33,-1,1,"add: May change over time."]],0,1020],[7251654,20433,2,0.149,0.082,[[16,0.5,26,1