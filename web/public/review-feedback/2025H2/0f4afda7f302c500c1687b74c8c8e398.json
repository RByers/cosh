ere instead of relying on the default being zero (as opposed to null; some types like to distinguish and it's nice to be explicit?)"]],0,145],[7157652,20406,15,0.399,0.286,[[36,1]],[],0,146],[7157611,20406,1,0.078,0.051,[[7,21]],[],0,147],[7169625,20410,346,6.536,5.29,[[7,1.0,22,344]],[],0,148],[7254598,20434,2,0.142,0.088,[[2,7]],[],0,149]]}