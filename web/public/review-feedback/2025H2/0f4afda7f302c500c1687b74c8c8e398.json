ad of relying on the default being zero (as opposed to null; some types like to distinguish and it's nice to be explicit?)"]],0,145],[7157652,20406,15,0.573,0.414,[[36,1]],[],0,146],[7157611,20406,1,0.112,0.081,[[7,21]],[],0,147],[7169625,20410,102,1.152,1,[[7,1.0,22,101]],[],0,148],[7254598,20434,1,0.197,0.133,[[2,7]],[],0,149]]}