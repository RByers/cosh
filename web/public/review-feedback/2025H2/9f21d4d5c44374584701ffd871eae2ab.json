20361,3,0.158,0.09,[[0,69]],[],0,149],[7037932,20375,4,0.321,0.203,[[0,70]],[],0,150],[7088077,20396,117,2.91,2.334,[[0,0.69,71,85],[23,0.163,14,18],[14,0.054,4,6],[3,0.047,8,4],[5,0.023,32,2],[21,0.023,14,2]],[["",47,-8,1],["",48,-8,1],["",48,-8,1],["",49,-7,1],["",50,-7,1],["",7,-4,1],["",51,-4,0],["",52,-4,1],["",53,-4,1],["",54,-4,1]],0,151],[7113262,20397,18,0.746,0.564,[[0,72]],[],0,152],[7088042,20398,953,16.15,13.645,[[0,0.998,73,952],[6,0.002,23,1]],[["",54,-6,1],["",54,-6,1],["",54,-6,0],["",54,-6,1],["374baab9_b6ac7b35",54,-2,1,"I agree with this comment. You could just create a new object that you std::move into the callback containing all data you need -- I don't think that would be difficult."],["dc6e1db2_0f988b2f",54,-2,1,"why this? we don't do this for regular requests, intentionally"],["e3a2e7f4_61ce0de5",54,-2,1,"Just don't call this method if you don't have a disconnect handler? (also, there's base::DoNothing())"],["3b03525a_e80d7b26",54,-1,1,"(It is probably more likely that the page initiated a new navigation in the meantime, which seems different from the definition of concurrent in that doc)"],["86e0a380_6fae1ebf",54,-1,1,"I wonder -- do we eventually want to support redirect URLs for regular fedcm requests? Even if not, should we move the URL loading logic into request_service, similar to continue_on? Anyway, just…"],["af57a645_ca7f8406",55,-1,1,"maybe also add a test that chrome:// URLs are not allowed?"],["c1a3aa78_b01701ed",53,-1,0,"Is there a reason you made this and ResponseBuilder a class instead of just adding BuildRequest/BuildResponse functions?"]],0,153],[7219209,20425,82,2.91,2.334,[[0,74]],[["4805929b_a5150e3b",53,0,0,"nit: `ProcessResponseInternal`?"]],0,154],[7113405,20426,154,4.528,3.643,[[0,75]],[["4820ee7f_034b8eec",17,-30,1,"Why not `private_key.IsEd25519()`?"],["4cf0e057_6c68143b",17,-30,1,"this function is so similar to SignJwtRs256... I almost wonder if it should be a single function with a SignatureKind parameter, although that would make checking the key type a bit more complex. Hmm…"],["5e9b6793_f7d7574e",20,-30,1,"since this function now specifically does test Ed25519 this comment should probably change"],["bed93e8b_aac76893",20,-30,1,"this test name seems wrong now But it does seem like testing an unsupported key type may be useful? Maybe GenerateEcP384()?"],["ec28609f_bd021f82",17,0,1,"nit: this can stay out of the if-else block."],["ed7c90f7_dcf99aee",17,0,0,"I saw you had used `switch (EVP_PKEY_base_id(private_key.key())) ` in previous patchsets, why changing it to if-else? In general switch-case is preferred in this case."]],0,155],[7123213,20426,55,1.404,1.068,[[0,76]],[["3bc5b7ef_2b324cf8",23,-29,1,"Can you use `public_key.alg` isntead of passing this explicitly?"],["56892679_7cdf667b",23,-29,1,"Why did you move this line? The `kb_jwt.Sign` call below modifies the kb_jwt object, but in this case you already copied it into sd_jwt_kb, so how dose that work?"],["c09045cd_5c2c2f2e",23,0,0,"Is this comment still correct with the change? Unrelated: it's better to file separate bugs for each TODO rather than reusing the meta bug. Otherwise when the meta bug is closed when the prototype is…"],["e7a42f59_7455fdaa",23,0,1,"Q: is it worth adding something here to say that the type is not supported? e.g. throwing errors, log metrics etc. Perhaps leave a TODO for now?"],["41c09461_c073eee0",23,5,0,"This TODO is probably obsolete now?"]],0,156],[7226420,20426,3,0.158,0.09,[[0,77]],[],0,157],[7189320,20427,555,10.971,8.929,[[24,0.979,2,545],[25,0.016,0,8],[26,0.005,3,2]],[["7a724888_dffdf21f",56,-11,1,"similarly you can do `@JniType(\"std::optional<std::string>\") String data` here"],["82c5ff24_584ea4eb",57,-11,1,"Why is this needed?"],["a0e1dac3_12db2f39",56,-11,1,"if you add a `@JniType(\"std::string\")` annotation then you don't need the explicit conversions in the C++ code (e.g. `@JniType(\"std::string\") String packageName`)"],["a30c9cab_8a2a33dd",7,-11,1,"Please fix this WARNING reported by Spellchecker: \"subsquent\" is a possible misspelling of \"subsequent\". To bypass Spellchecker, ... \"subsquent\" is a possible misspelling of \"subsequent\". To bypass…"],["c28d6a6b_691cf3db",56,-11,1,"what's 2? probably better to define constants for these magic numbers."],["375e87d5_2db9a40a",58,-3,1,"The fact that we are the first one adding stuff in this file seems suspicious.. Please check with the owner."],["83883519_e89d1fa9",57,-3,1,"Not an expert on this. For \"action\", I thought it should end with a verb such as `SEND`, `REQUEST` or something like that. Feel free to ignore if that's not the case."],["138db14a_c8c06fe6",56,-1,1,"Naming nit, but BoundService is very generic naming. https://developer.android.com/develop/background-work/services/bound-services I would add some prefix here that makes it specific as…"],["4c653fc1_e56b330d",56,-1,1,"I'd make this a constant."],["81c9ff29_a017cab3",56,-1,1,"add 'e' to the debug log? Log.d(TAG, \"Oops remote exception\", e);"],["ce357c35_1bb124d5",56,-1,0,"@mthiesse -- do you happen to know if we should call queryIntentServices on a background thread?"],["d56ed9d1_98e26d31",56,-1,1,"Is \"reply\" an expected long running constant? Wondering if this should be a constant either way."]],0,158],[7237401,20438,62,2.122,1.642,[[11,0.276,20,19],[23,0.263,15,17],[2,0.132,50,8],[0,0.118,78,7],[3,0.079,9,4],[27,0.053,1,3],[4,0.039,7,2],[21,0.039,15,2]],[],0,159]]}