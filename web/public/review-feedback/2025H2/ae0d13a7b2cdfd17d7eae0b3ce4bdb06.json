,4,89],[3,0.471,9,80]],[["7b169d7e_349e908c",65,-4,1,"Do you mind attaching a screen recording of the following cases? - Move a mouse cursor over a link (fade-in) - Move a mouse cursor away from a link (fade-out) - Move a mouse cursor from a link to…"],["87d93df7_6107c697",65,-4,1,"nit: Should we reset the animator to null when the bar is showing?"],["914aa4c9_da8c7099",65,-4,1,"If the link just received an update (meaning the visibility does not change), seems we don't need to start another animation."],["81906342_4f2ebf14",65,-3,1,"optional nit: The level of indentation makes the code quite hard to read. Can you please inline some of these? ``` Runnable hideStatusBar = () -> { mStatusBarAnimator = // ....…"]],0,27],[6904863,20411,146,4.14,3.17,[[22,0.513,0,76],[16,0.447,1,66],[20,0.04,1,4]],[["",69,-77,1],["",69,-77,1],["",69,-40,1],["",69,-34,1],["",69,-34,1],["3b696812_79c4b4ed",69,-12,0,"You can check whether mRecyclerViewSnapshotOverlay is not null instead."],["886f307e_771a2d1a",69,-12,1,"No need to create this on non-tablet or the feature is not enabled. Also, please move this with addView."],["b84ca26c_0e8575af",69,-12,0,"Does this get called multiple times during a resizing process?"],["bd35cec9_81e6e14a",69,-12,1,"Call ViewUtils.captureBitmap() to capture a snapshot. Also do we want to consider scaling down the cached snapshot to save memory?"],["13f4152c_8e1bc5d7",69,-2,0,"nit: checking sFluidResize is not needed since mRecyclerViewSnapshotOverlay is already controlled by it."],["3a7fc585_1be9c5da",70,-2,1,"You should also add the test to cover the case when recyclerView becomes visible again."],["be1f24b1_5be7b5d2",69,-2,1,"Please also add check for isNonMultiDisplayContextOnTablet to exclude non-tablet case."],["ed088655_c9c0eef4",69,-2,1,"nit: you should import it. Also you could simplify the code with instanceof pattern matching, like: ``` if (drawable instanceof BitmapDrawable bitmapDrawable) { Bitmap bitmap =…"]],0,28],[7155440,20414,195,4.14,3.17,[[3,0.824,10,162],[17,0.146,1,28],[18,0.03,2,5]],[["342e8696_a4188ddf",65,-5,1,"What is the reasoning behind this calculation? Do you mind adding a comment to explain it?"],["3ffb4750_a83077ed",31,-5,1,"For better encapsulation, how about moving this code to the LinkHoverStatusBarCoordinator constructor? You can pass the CompositorViewHolder in the same way as AutomotiveBackButtonToolbarCoordinator…"],["96a2d6fd_19269564",65,-5,1,"What happens if the cursor position is currently oustide of the status bar rect, but the rect in the original position contains the cursor position? Doesn't this result in moving the status bar…"],["d0d8f87e_e9c2a6cf",65,-5,1,"Styling nit: If you wrap the setLayoutParams calls in a helper method, it could greatly benefit the readability. Or you could add some java docs ``` if (cursorOverlapWithStatusBar) { if (...) {…"],["f8048a06_880d24eb",65,-5,1,"nit: \"avoidCursor\" is a vague name. Use a more descriptive name e.g. `adjustStatusBarPositionForCursor`."],["f9965232_e2b5a0e0",65,-5,1,"Do you mind adding a screenshot for this case (i.e. moving the bar downwards)?"],["1184ac0d_c81c2b8a",65,-3,1,"Remove extra space?"],["60856bdd_1692ee4e",65,-3,1,"nit: this blank line is redundant."],["a12b05f4_d0e50426",65,-3,1,"This overwrites the tab view's hover listener. Is this safe to do? Isn't there any other component that sets its own onHoverListener that might be overwritten? This looks fragile because any other…"],["c598d2c2_bf4966ed",65,-3,1,"We seem to always be setting this to 0 (here and in below code path). Do we need these lines anymore?"],["c885621a_b231f6f4",65,-3,1,"nit: redundant blank line."],["eccc4976_7cfba1bd",65,-3,1,"Should this be mMargin?"],["ece9d4a0_d0c6269f",65,-3,1,"nit: this blank line is redundant."],["2faf6632_d95247ed",65,-2,1,"Downcasting is discouraged in general. If you want to access ContentView, you can use getContentView().…"],["6d9b2492_29b6fe7f",65,-2,1,"How about making this class an implementation of View.OnHoverListener to directly receive the event object? The event object contains more than the cursor corrdinates (e.g. action type is set to…"],["b9d58fd2_d8e2dab4",65,-2,1,"Can we avoid calling setOnHoverListener()? This can be broken if someone else decides to call setOnHoverListener() for some other reason."],["def4035d_425d10b8",65,-2,1,"ditto Downcasting is generally discouraged."],["2ffaf97f_145eaa2e",65,-1,1,"nit: Empty blank line"],["dc87faa5_099dfa86",65,-1,1,"nit: Can this be private?"]],0,29],[7274760,20446,31,0.796,0.587,[[8,0.879,5,28],[3,0.121,11,3]],[["3616bd83_2cbb8a9f",65,-5,1,"Thank you for caring about the details about accessibility, but probably the existing behavior is OK? On a ChromeOS laptop, if you move focus using the tab key to a link in a web page, it shows the…"],["46589bdf_177d2eeb",71,-5,1,"How about adding a test case to check that the status bar is not shown when it shouldn't be?"],["9969bd22_2ea3e06c",71,-2,1,"Not necessary?"]],0,30]]}