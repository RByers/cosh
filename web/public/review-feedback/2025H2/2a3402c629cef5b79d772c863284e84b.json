2759,20399,395,5.985,5.2,[[19,0.52,3,202],[20,0.302,1,120],[17,0.168,3,64],[22,0.01,0,3]],[["51447c47_86d9f416",23,-2,1,"The Gerrit UI is showing there is no testing coverage for these lines. If that's true, could you please add some? (This may be the same as the testing coverage request we discussed on a previous CL…"],["6beb2bab_35b49c38",34,-2,1,"nit: It is a little odd that this includes back to the service. Would it work to define `OtpPhishingVerdictCallback` in here instead?"],["9d2326a9_a5095b2e",35,-2,0,"Thanks!"],["b14c7373_e1bb80ff",29,-2,1,"Can we move the `request` definition inside this if statement since it's not used by the else branch? I think that means we don't need the cast. ``` if (CanSendPing(...)) {…"],["e3acf123_701f0aad",34,-2,1,"Please use `CHECK` instead of `DCHECK`. See https://chromium.googlesource.com/chromium/src/+/HEAD/styleguide/c++/checks.md#invariant_verification-mechanisms . ```suggestion…"],["135b527e_dfb3ac7b",36,-1,1,"Nit: Can we fix the argument comments here too?"],["5e8b92d6_ef6f617b",22,-1,1,"Wouldn't we also want to verify that LOW_REPUTATION verdicts are handled correctly too?"],["70014f3f_cc5dcdb4",35,-1,1,"I think is being done just to prove that verdict changed its value? If we want to ensure that `verdict` is `false`, couldn't we add an assertion in the BindLambdaForTesting?"],["793b5e21_19aaee6a",35,-1,1,"This variable name is too broad. A more precise name is more like `should_autofill_otp`."],["987711e2_93114804",30,-1,1,"Nit: `/*password_field_exists=*/true`"],["a9968a52_b0938c91",30,-1,1,"Nit: Could argument comments be added where a literal or GURL() is being passed in?"]],0,74],[7145938,20406,32,1.112,0.852,[[21,0.436,2,14],[7,0.359,3,12],[18,0.205,1,6]],[],0,75],[7156742,20410,24,1.154,0.872,[[4,19]],[["df0a0257_5cf03246",0,0,0,"😮"]],0,76],[7185278,20418,382,11.951,9.625,[[4,0.804,20,311],[23,0.196,0,71]],[["0efa66bf_42ccdf8f",37,-2,1,"In my experience such `raw_ptr` members in tests are prone to dangling. I'd rather add a getter that returns `static_cast<MockOneTimeTokenService&>(*autofill_client().GetOneTimeTokenService())`."],["0f7a2aee_fcf06f71",38,-2,1,"nit: `if (base::Contains(recent_otps, field_value))`?"],["12659953_69ddc6f5",39,-2,1,"nit: spell out the type (go/cstyle#Type_deduction)?"],["2e5f9d11_fea028a7",38,-2,1,"isn't this slower than directly comparing strings as done below? --> is this preselection worth it?"],["374c490e_cf3f6c73",40,-2,1,"nit: remove"],["42365aef_e275d647",38,-2,1,"You could consider to here and below precondition this on !recent_otp.empty()"],["6be1be6c_c3f5c376",40,-2,1,"nit: do `/*recent_otps=*/{}` because `std::u16string` is not very descriptive"],["6ca3ddcf_7cb80d8a",38,-2,1,"what is time here? Each for submission?"],["746b6dde_eed8b509",38,-2,1,"Do you want to swap order for late experiment assignment?"],["7ec0c4cd_bf46bef1",41,-2,1,"Shouldn't tests mock GetCachedOneTimeTokens()?"],["859c7962_447517dd",41,-2,1,"std::move()?"],["93053923_3b9f98ac",39,-2,1,"I wonder whether it would it be better to return `OneTimeToken`s here, for two reasons: More type-safety on the path up to where `VotesUploader` compares the values. And for future callers because…"],["b095f523_78c9df17",42,-2,1,"This member looks like it shouldn't be one 😊 Why do we need it?"],["cfc72983_d4fd01eb",43,-2,1,"Regarding the parameter ordering: Isn't this conceptually closest to `profiles`, `cerid)_cards`, `entities`, `loyalty_cards`?"],["da515a2c_49f28d50",40,-2,1,"Our tests don't usually log things, I assume because there's an upper bound to the terminal output on the bots. There's [this…"],["e0a550e9_fecc437a",42,-2,1,"nit: This looks like a use-case for [`base::expected`](https://source.chromium.org/chromium/chromium/src/+/main:base/types/expected.h;l=25-28;drc=b39481fd31a44988cd75a6372b2cd5be0241bccc)."],["e8b1a88c_b634c97b",44,-2,1,"The bug number is missing"],["19e6e24d_e71ff6d2",39,-1,1,"opt: `return base::ToVector(cache_.GetCache())` is even shorter 😊"],["16bc6b90_f5cbd65f",38,0,1,"this is somehow an overstatement because the recent OTPs may actually remain constant over multiple submissions."],["e53b6aae_f6090b68",41,0,0,"since recent_otps are const, you could consider using the ternary. ``` auto* token_service = client_->GetOneTimeTokenService(); const std::vector<OneTimeToken> recent_otps = token_service ?…"]],0,77],[7203226,20418,43,1.21,0.931,[[23,0.708,1,31],[4,0.292,21,12]],[["a5393aed_b4509736",45,-1,1,"These shouldn't be in headers (because every other file that includes the header inherits them): go/cstyle#Aliases"]],0,78],[7202693,20418,2,0.116,0.046,[[4,22]],[],0,79],[7208860,20420,10,0.407,0.29,[[2,5]],[],0,80],[7213564,20425,31,1.08,0.91,[[19,4]],[],0,81],[7245851,20432,78,2.202,1.731,[[23,0.699,2,55],[4,0.301,23,23]],[],0,82]]}