..>*`) or use `base::optional_ref<const vector<...>>`."]],0,350],[6962334,20399,306,4.91,3.884,[[4,79]],[["",17,-50,1],["",17,-50,1],["",18,-45,1],["",18,-45,1],["",18,-45,0],["",18,-45,1],["",18,-45,1],["",18,-45,1],["",18,-45,1],["",19,-8,1],["",18,-8,1],["",18,-8,1],["",18,-8,1],["",18,-8,1],["",18,-8,1],["1688c89d_e16ec7b4",18,-2,1,"Do we need to take by value here? Otherwise `const std::array<std::string, 2>&` would be better. Ditto below."],["48650f45_cc6bbb5d",18,-2,1,"And `const std::vector<std::string>&`, or even `base::span<const std::string>`"],["846c74c9_7278d18f",18,-2,1,"I might suggest something simpler if it works: ```suggestion const HeapArray<const QualifiedName*> tags = svg_names::GetTags(); return std::vector(tags.begin(), tags.end()); ``` Ditto below."],["9d1e9b54_bcb330d1",18,-2,0,"I guess this is OK since we move the copy below."],["9e6da069_dec7bcc6",18,-2,0,"This is fine though; no need to change the doubles."],["e0c25ace_7cd83f8a",18,-2,1,"Same here: `const std::string&`, et cetera"],["fcc980d9_0bf2cecc",18,-2,1,"Can we destructure as `const auto&` here to avoid copies? Ditto below."]],0,351],[6962674,20399,210,2.983,2.275,[[4,80]],[],0,352],[6965088,20406,493,4.91,3.884,[[4,81]],[["",20,-53,1],["",20,-51,0],["",20,-45,1],["",21,-45,1],["",21,-22,0],["",10,-22,1],["ac75242f_24ffada4",20,0,1,"Nit: this doesn't really hurt, but it also doesn't do anything. I'd probably just drop this const."],["fecb9303_8269ae52",9,0,1,"Does `AtomicString::FromUTF8(input.stylesheet)` work?"]],0,353],[7021756,20413,201,2.983,2.275,[[4,82]],[["d7bc76c0_f530b89a",22,-2,1,"How do we get to 13 for 3x3 (1 table, 3 rows, 9 cells)? SHouldn't this come from the node spec below?"],["004bcf70_abe2462c",11,-1,1,"`static constexpr auto kAttributes = std::to_array<const QualifiedName*>({&html_names::kScopeAttr, ...});` if that works. Otherwise use `NoDestructor` instead of `new`"],["88c7f37f_000ad4f1",20,-1,1,"I would suggest `static auto kTableRoles = std::to_array<std::string_view>({...});` here if that works with `ElementOf`"],["8cf925e1_a6723e70",20,-1,1,"```suggestion return std::vector({ html_names::kAriaColcountAttr, html_names::kAriaColindexAttr, ... }); ```"]],0,354],[7027494,20415,106,1.636,1.222,[[4,83]],[["149a72a9_68a3c208",22,-2,1,"This pattern occurs quite a few times. Any value in trying to clean it up with a helper to make this a bit more readable?"],["ad8ba2ea_2a3b3f86",22,-2,1,"nit: let's sort this list."],["752b109a_975b3ecf",22,-1,0,"IMO this comment would be more helpful if it mentioned something like \"Soft hypens are problematic, e.g. see crbug.com.x, crbug.com/y, and crbug.com/z."],["8cb73dfd_6fceb14f",22,-1,1,"```suggestion return base::StrCat(prop_name.ToAtomicString().Utf8(), \":\", value); ```"]],0,355],[7054362,20417,152,2.983,2.275,[[4,84]],[["01ae2a79_e93b4425",22,-1,1,"Should we promote this up to HtmlAndAria since accessibility drills into shadow DOM by default to build accessibility trees?"],["e4db4531_3dd28ec8",9,0,1,"StrCat here if we can, whether the base or Blink one."]],0,356]]}