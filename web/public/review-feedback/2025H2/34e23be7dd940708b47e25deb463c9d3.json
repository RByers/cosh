169985,20416,700,15.464,12.617,[[0,0.963,120,885],[8,0.015,55,12],[10,0.011,26,7],[15,0.006,33,5],[26,0.004,9,3]],[["3f5eb576_88a68b13",17,-4,1,"`git cl format`?"],["77f66fa9_5a052b50",17,-4,0,"Not a Cpp expert here, but I'm afraid the `Impl` parts are being stripped off here and causing a UB (later during static_cast). The rvalue constructor may be helping here, but it looks dangerous to…"],["30e22564_0c993dee",18,-3,1,"nit: Google Password Manager passkey"],["492780f2_b71b3bb3",19,-3,1,"this file's existence is now confusing and I'm unsure how we should handle this. Maybe we can move this file to credential_sorter_desktop_unittest.cc for now? And later we can create a generic test…"],["7ace6d08_4f58ddec",20,-3,1,"Can you please rename to `WebAuthnDeduplicatedType`; and rename `kEnclavePasskey` to `kGPMPasskey`?"],["e5fcb403_9ca52202",20,-3,1,"can we place these functions in the webauthn namespace? The usage in ARDC was a bit confusing."],["f2265dfa_370e45e6",17,-3,1,"nit - I prefer to call them GPM passkeys here and below in the code"],["f9e5659e_687cbb34",17,-3,1,"optional: move this to credential_sorter_android.h/cc and desktop to credential_sorter_desktop.h/cc"]],0,530],[7205606,20418,412,10.07,8.247,[[10,0.909,27,377],[11,0.058,34,23],[0,0.033,121,13]],[["05eac94d_0435b9b3",21,0,1,"Why not base::span?"],["243895d4_6cee5386",21,0,1,"Please use the full type unless it can be easily inferred from the immediately-adjacent lines. The use of `auto maybe_passkeys` above is also not really compliant with the code style."],["37779d51_55f35fca",22,0,1,"Same here."],["b92ae793_5509a406",21,0,1,"Since you're modifying code around this anyway, could you please fix the type here too. It is non-intuitive."],["cb7bcdfa_59104b92",22,0,1,"Please use named constants to improve readability."]],0,531],[7208389,20420,10,0.597,0.431,[[0,0.667,122,7],[27,0.333,38,3]],[["675b4c23_958edd20",1,0,1,"nit: during?"]],0,532],[7233692,20430,73,2.282,1.723,[[17,0.645,52,48],[8,0.355,56,25]],[