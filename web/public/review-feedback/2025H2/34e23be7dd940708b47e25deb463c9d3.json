0416,1092,9.499,7.568,[[0,0.963,120,1467],[8,0.018,55,25],[10,0.01,26,13],[15,0.005,33,7],[26,0.003,9,4]],[["3f5eb576_88a68b13",17,-4,1,"`git cl format`?"],["77f66fa9_5a052b50",17,-4,0,"Not a Cpp expert here, but I'm afraid the `Impl` parts are being stripped off here and causing a UB (later during static_cast). The rvalue constructor may be helping here, but it looks dangerous to…"],["30e22564_0c993dee",18,-3,1,"nit: Google Password Manager passkey"],["492780f2_b71b3bb3",19,-3,1,"this file's existence is now confusing and I'm unsure how we should handle this. Maybe we can move this file to credential_sorter_desktop_unittest.cc for now? And later we can create a generic test…"],["7ace6d08_4f58ddec",20,-3,1,"Can you please rename to `WebAuthnDeduplicatedType`; and rename `kEnclavePasskey` to `kGPMPasskey`?"],["e5fcb403_9ca52202",20,-3,1,"can we place these functions in the webauthn namespace? The usage in ARDC was a bit confusing."],["f2265dfa_370e45e6",17,-3,1,"nit - I prefer to call them GPM passkeys here and below in the code"],["f9e5659e_687cbb34",17,-3,1,"optional: move this to credential_sorter_android.h/cc and desktop to credential_sorter_desktop.h/cc"]],0,530],[7205606,20418,703,10.971,8.929,[[10,0.921,27,651],[11,0.054,34,37],[0,0.025,121,17]],[["05eac94d_0435b9b3",21,0,1,"Why not base::span?"],["243895d4_6cee5386",21,0,1,"Please use the full type unless it can be easily inferred from the immediately-adjacent lines. The use of `auto maybe_passkeys` above is also not really compliant with the code style."],["37779d51_55f35fca",22,0,1,"Same here."],["b92ae793_5509a406",21,0,1,"Since you're modifying code around this anyway, could you please fix the type here too. It is non-intuitive."],["cb7bcdfa_59104b92",22,0,1,"Please use named constants to improve readability."]],0,531],[7208389,20420,11,0.421,0.3,[[0,0.615,122,7],[27,0.385,38,4]],[["675b4c23_958edd20",1,0,1,"nit: during?"]],0,532],[7233692,20430,73,1.637,1.223,[[17,0.645,52,48],[8,0.355,56,25]],[["8985c667_08fd123d",13,-3,1,"It is a little strange that some unrelated errors preclude this metric from being logged, but some others don't. Perhaps move this to a point where we know the request will go through?"],["b5e215a5_4515b9c3",13,-3,1,"Doesn't this need a `(WebAuthenticationResidentKeyRequirement)` so the label on ifttt works? Is it possible you had to silence the warning because this is missing?"],["e1aec6d3_40b5d6ad",18,-3,1,"You added an ifttt label here but did not refer to it on the other side."],["f2133e21_0d38f46a",13,-3,1,"This logs unknown values as \"required\", which feels wrong. Since `residentKey` is a `DOMString`, it could take any form. Maybe add an \"unknown\" value to the enum?"]],0,533]]}