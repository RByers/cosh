{
  "name": "cosh-web",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "description": "cosh static web UI (GitHub Pages)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
