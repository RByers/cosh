# Raw Gerrit caches and rebuildable DBs: too big to commit (docs/storage-design.md §4)
data/private/
.research/gerrit/responses/
__pycache__/

# credentials live in ~/.secrets/cosh/ (SECURITY.md); this is a backstop
secrets*
# one-off research downloads (re-fetchable)
.research/affiliations/
*.pyc

.claude/worktrees

# Per-person files live in data/private and the R2 bucket (config/r2.json, docs/r2.md);
# never commit them here again
web/public/review-feedback/*/
web/public/review-load/*/
